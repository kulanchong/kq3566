diff --git a/package/boot/uboot-rockchip/src/arch/arm/dts/rk3566-kq3566.dts b/package/boot/uboot-rockchip/src/arch/arm/dts/rk3566-kq3566.dts
new file mode 100644
index 0000000000..ef5e37bc88
--- /dev/null
+++ b/package/boot/uboot-rockchip/src/arch/arm/dts/rk3566-kq3566.dts
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+#include "rk3566-nanopi-r3s.dts"
+
+/ {
+	model = "KQ3566";
+	compatible = "kq,kq3566", "rockchip,rk3566";
+
+	adc-keys-0 {
+		compatible = "adc-keys";
+		io-channels = <&saradc 0>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <1800000>;
+		poll-interval = <100>;
+
+		button-maskrom {
+			label = "Mask Rom";
+			linux,code = <KEY_SETUP>;
+			press-threshold-microvolt = <2000>;
+		};
+	};
+
+	vcc_3v3_kq: regulator-vcc-3v3-kq {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_3v3";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+	};
+
+	vcc_1v8_kq: regulator-vcc-1v8-kq {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_1v8";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+	};
+
+	vdd_cpu_kq: regulator-vdd-cpu-kq {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_cpu";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <955000>;
+		regulator-max-microvolt = <955000>;
+	};
+
+	vdd_logic_gpu_npu_kq: regulator-vdd-logic-gpu-npu-kq {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_logic_gpu_npu";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <920000>;
+		regulator-max-microvolt = <920000>;
+	};
+
+	vcc3v3_sd_kq: regulator-vcc3v3-sd-kq {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3_sd";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&sdmmc0_pwren>;
+		startup-delay-us = <800000>;
+		vin-supply = <&vcc_3v3_kq>;
+	};
+
+	vccio_sd_kq: regulator-vccio-sd-kq {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&sdmmc0_vol_ctrl_h>;
+		regulator-name = "vccio_sd";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc_3v3_kq>;
+	};
+};
+
+&cpu0 {
+	cpu-supply = <&vdd_cpu_kq>;
+};
+
+&cpu1 {
+	cpu-supply = <&vdd_cpu_kq>;
+};
+
+&cpu2 {
+	cpu-supply = <&vdd_cpu_kq>;
+};
+
+&cpu3 {
+	cpu-supply = <&vdd_cpu_kq>;
+};
+
+&gpu {
+	mali-supply = <&vdd_logic_gpu_npu_kq>;
+};
+
+&i2c0 {
+	status = "disabled";
+};
+
+&i2c1 {
+	status = "disabled";
+};
+
+&pmu_io_domains {
+	pmuio1-supply = <&vcc_3v3_kq>;
+	pmuio2-supply = <&vcc_3v3_kq>;
+	vccio1-supply = <&vcc_3v3_kq>;
+	vccio2-supply = <&vcc_1v8_kq>;
+	vccio3-supply = <&vccio_sd_kq>;
+	vccio4-supply = <&vcc_3v3_kq>;
+	vccio5-supply = <&vcc_1v8_kq>;
+	vccio6-supply = <&vcc_1v8_kq>;
+	vccio7-supply = <&vcc_3v3_kq>;
+	status = "okay";
+};
+
+&saradc {
+	vref-supply = <&vcc_1v8_kq>;
+	status = "okay";
+};
+
+&sdmmc0 {
+	/delete-property/ sd-uhs-sdr50;
+	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
+	no-1-8-v;
+	vmmc-supply = <&vcc3v3_sd_kq>;
+	vqmmc-supply = <&vccio_sd_kq>;
+};
+
+&gmac1 {
+	phy-supply = <&vcc_3v3_kq>;
+	pinctrl-0 = <&gmac1m1_miim
+		     &gmac1m1_tx_bus2_level3
+		     &gmac1m1_rx_bus2
+		     &gmac1m1_rgmii_clk_level2
+		     &gmac1m1_rgmii_bus_level3
+		     &gmac1m1_clkinout>;
+};
+
+&pcie2x1 {
+	reset-gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_LOW>;
+};
+
+&pcie_reset_h {
+	rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
+};
+
+&sdmmc0_pwren {
+	rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
+};
+
+&rgmii_phy1 {
+	interrupt-parent = <&gpio0>;
+	interrupts = <RK_PC4 IRQ_TYPE_LEVEL_LOW>;
+	pinctrl-0 = <&eth_phy_reset_pin>, <&eth_phy_int_pin>;
+};
+
+&pinctrl {
+	gmac {
+		eth_phy_int_pin: eth-phy-int-pin {
+			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	sdmmc0 {
+		sdmmc0_vol_ctrl_h: sdmmc0-vol-ctrl-h {
+			rockchip,pins = <0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
