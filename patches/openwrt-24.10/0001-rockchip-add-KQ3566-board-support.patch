diff --git a/target/linux/rockchip/patches-6.6/011-07-arm64-dts-rockchip-add-kq3566-board.patch b/target/linux/rockchip/patches-6.6/011-07-arm64-dts-rockchip-add-kq3566-board.patch
new file mode 100644
index 0000000000..98e9b49654
--- /dev/null
+++ b/target/linux/rockchip/patches-6.6/011-07-arm64-dts-rockchip-add-kq3566-board.patch
@@ -0,0 +1,369 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: OpenWrt Builder <builder@example.com>
+Date: Thu, 25 Jun 2026 21:20:00 -0400
+Subject: [PATCH] arm64: dts: rockchip: add KQ3566 board
+
+KQ3566 is an RK3566 DDR3 board close to NanoPi R3S in boot and Ethernet
+topology, but it uses discrete regulators instead of the R3S
+RK809/TCS4525/HYM8563 power tree. Add a dedicated Linux device tree that
+keeps the R3S storage and PCIe topology while describing the KQ power
+rails, fixed 3.3V SD rail, RTL8211F RGMII wiring, and RTL8111H PCIe
+PERSTB line.
+---
+ arch/arm64/boot/dts/rockchip/Makefile          |   1 +
+ arch/arm64/boot/dts/rockchip/rk3566-kq3566.dts | 339 ++++++++++++++++++
+ 2 files changed, 339 insertions(+)
+ create mode 100644 arch/arm64/boot/dts/rockchip/rk3566-kq3566.dts
+
+--- a/arch/arm64/boot/dts/rockchip/Makefile
++++ b/arch/arm64/boot/dts/rockchip/Makefile
+@@ -86,6 +86,7 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-p
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-quartz64-b.dtb
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-radxa-cm3-io.dtb
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-radxa-zero-3e.dtb
++dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-kq3566.dtb
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-radxa-zero-3w.dtb
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-roc-pc.dtb
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-soquartz-blade.dtb
+--- /dev/null
++++ b/arch/arm64/boot/dts/rockchip/rk3566-kq3566.dts
+@@ -0,0 +1,339 @@
++// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
++
++#include "rk3566-nanopi-r3s.dts"
++
++/ {
++	model = "KQ3566";
++	compatible = "kq,kq3566", "rockchip,rk3566";
++
++	aliases {
++		led-boot = &working_led;
++		led-failsafe = &working_led;
++		led-running = &working_led;
++		led-upgrade = &working_led;
++	};
++
++	hdmi_con: hdmi-con {
++		compatible = "hdmi-connector";
++		type = "a";
++
++		port {
++			hdmi_con_in: endpoint {
++				remote-endpoint = <&hdmi_out_con>;
++			};
++		};
++	};
++
++	adc-keys-0 {
++		compatible = "adc-keys";
++		io-channels = <&saradc 0>;
++		io-channel-names = "buttons";
++		keyup-threshold-microvolt = <1800000>;
++		poll-interval = <100>;
++
++		button-maskrom {
++			label = "Mask Rom";
++			linux,code = <KEY_SETUP>;
++			press-threshold-microvolt = <2000>;
++		};
++	};
++
++	vcc12v_dcin_kq: regulator-vcc12v-dcin-kq {
++		compatible = "regulator-fixed";
++		regulator-name = "VCC12V_DCIN";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <12000000>;
++		regulator-max-microvolt = <12000000>;
++	};
++
++	vcc_1v8_kq: regulator-vcc-1v8-kq {
++		compatible = "regulator-fixed";
++		regulator-name = "VCC_1V8";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <1800000>;
++		regulator-max-microvolt = <1800000>;
++		vin-supply = <&vcc3v3_sys>;
++	};
++
++	vcca_1v8_kq: regulator-vcca-1v8-kq {
++		compatible = "regulator-fixed";
++		regulator-name = "VCCA_1V8";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <1800000>;
++		regulator-max-microvolt = <1800000>;
++		vin-supply = <&vcc3v3_sys>;
++	};
++
++	vdda_0v9_kq: regulator-vdda-0v9-kq {
++		compatible = "regulator-fixed";
++		regulator-name = "VDDA_0V9";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <900000>;
++		regulator-max-microvolt = <900000>;
++		vin-supply = <&vcc3v3_sys>;
++	};
++
++	vcc_3v3_kq: regulator-vcc-3v3-kq {
++		compatible = "regulator-fixed";
++		regulator-name = "VCC_3V3";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <3300000>;
++		regulator-max-microvolt = <3300000>;
++		vin-supply = <&vcc3v3_sys>;
++	};
++
++	vcc_ddr_kq: regulator-vcc-ddr-kq {
++		compatible = "regulator-fixed";
++		regulator-name = "VCC_DDR";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <1350000>;
++		regulator-max-microvolt = <1350000>;
++		vin-supply = <&vcc12v_dcin_kq>;
++	};
++
++	vccio_flash_kq: regulator-vccio-flash-kq {
++		compatible = "regulator-fixed";
++		regulator-name = "VCCIO_FLASH";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <1800000>;
++		regulator-max-microvolt = <1800000>;
++		vin-supply = <&vcc_1v8_kq>;
++	};
++
++	vdd_cpu_kq: regulator-vdd-cpu-kq {
++		compatible = "pwm-regulator";
++		pwms = <&pwm0 0 5000 1>;
++		regulator-name = "VDD_CPU";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <810000>;
++		regulator-max-microvolt = <1200000>;
++		regulator-settling-time-up-us = <250>;
++		pwm-supply = <&vcc5v0_sys>;
++	};
++
++	vdd_logic_gpu_npu_kq: regulator-vdd-logic-gpu-npu-kq {
++		compatible = "pwm-regulator";
++		pwms = <&pwm1 0 5000 1>;
++		regulator-name = "VDD_LOGIC_GPU_NPU";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <920000>;
++		regulator-max-microvolt = <920000>;
++		regulator-settling-time-up-us = <250>;
++		voltage-table = <920000 38>;
++		pwm-supply = <&vcc5v0_sys>;
++	};
++
++	vcc3v3_sd_kq: regulator-vcc3v3-sd-kq {
++		compatible = "regulator-fixed";
++		regulator-name = "VCC3V3_SD";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <3300000>;
++		regulator-max-microvolt = <3300000>;
++		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
++		pinctrl-names = "default";
++		pinctrl-0 = <&sdmmc0_pwren>;
++		startup-delay-us = <800000>;
++		vin-supply = <&vcc_3v3_kq>;
++	};
++
++	vccio_sd_kq: regulator-vccio-sd-kq {
++		compatible = "regulator-fixed";
++		enable-active-high;
++		gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
++		pinctrl-names = "default";
++		pinctrl-0 = <&sdmmc0_vol_ctrl_h>;
++		regulator-name = "VCCIO_SD";
++		regulator-always-on;
++		regulator-boot-on;
++		regulator-min-microvolt = <3300000>;
++		regulator-max-microvolt = <3300000>;
++		vin-supply = <&vcc_3v3_kq>;
++	};
++
++	gpio-leds {
++		pinctrl-0 = <&working_led_pin>;
++
++		/delete-node/ led-0;
++		/delete-node/ led-1;
++		/delete-node/ led-2;
++
++		working_led: led-working {
++			color = <LED_COLOR_ID_BLUE>;
++			function = LED_FUNCTION_STATUS;
++			gpios = <&gpio0 RK_PC3 GPIO_ACTIVE_HIGH>;
++		};
++	};
++};
++
++&vcc5v0_sys {
++	vin-supply = <&vcc12v_dcin_kq>;
++};
++
++&vcc3v3_sys {
++	regulator-name = "VCC3V3_SYS";
++};
++
++&cpu0 {
++	cpu-supply = <&vdd_cpu_kq>;
++};
++
++&cpu1 {
++	cpu-supply = <&vdd_cpu_kq>;
++};
++
++&cpu2 {
++	cpu-supply = <&vdd_cpu_kq>;
++};
++
++&cpu3 {
++	cpu-supply = <&vdd_cpu_kq>;
++};
++
++&cpu0_opp_table {
++	/delete-node/ opp-1992000000;
++};
++
++&gpu {
++	mali-supply = <&vdd_logic_gpu_npu_kq>;
++};
++
++&hdmi {
++	avdd-0v9-supply = <&vdda_0v9_kq>;
++	avdd-1v8-supply = <&vcca_1v8_kq>;
++	status = "okay";
++};
++
++&hdmi_in {
++	hdmi_in_vp0: endpoint {
++		remote-endpoint = <&vp0_out_hdmi>;
++	};
++};
++
++&hdmi_out {
++	hdmi_out_con: endpoint {
++		remote-endpoint = <&hdmi_con_in>;
++	};
++};
++
++&hdmi_sound {
++	status = "okay";
++};
++
++&i2c0 {
++	status = "disabled";
++};
++
++&i2c1 {
++	status = "disabled";
++};
++
++&pmu_io_domains {
++	pmuio1-supply = <&vcc_3v3_kq>;
++	pmuio2-supply = <&vcc_3v3_kq>;
++	vccio1-supply = <&vcc_3v3_kq>;
++	vccio2-supply = <&vccio_flash_kq>;
++	vccio3-supply = <&vccio_sd_kq>;
++	vccio4-supply = <&vcca_1v8_kq>;
++	vccio5-supply = <&vcc_1v8_kq>;
++	vccio6-supply = <&vcc_1v8_kq>;
++	vccio7-supply = <&vcc_3v3_kq>;
++	status = "okay";
++};
++
++&saradc {
++	vref-supply = <&vcca_1v8_kq>;
++	status = "okay";
++};
++
++&sdmmc0 {
++	/delete-property/ sd-uhs-sdr50;
++	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
++	no-1-8-v;
++	vmmc-supply = <&vcc3v3_sd_kq>;
++	vqmmc-supply = <&vccio_sd_kq>;
++};
++
++&gmac1 {
++	phy-supply = <&vcc_3v3_kq>;
++	tx_delay = <0x30>;
++	rx_delay = <0x10>;
++	pinctrl-0 = <&gmac1m1_miim
++		     &gmac1m1_tx_bus2_level3
++		     &gmac1m1_rx_bus2
++		     &gmac1m1_rgmii_clk_level2
++		     &gmac1m1_rgmii_bus_level3
++		     &gmac1m1_clkinout>;
++};
++
++&pcie2x1 {
++	reset-gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_LOW>;
++};
++
++&pcie_reset_h {
++	rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
++};
++
++&sdmmc0_pwren {
++	rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
++};
++
++&pwm0 {
++	status = "okay";
++};
++
++&pwm1 {
++	status = "okay";
++};
++
++&vop {
++	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
++	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
++	status = "okay";
++};
++
++&vop_mmu {
++	status = "okay";
++};
++
++&vp0 {
++	vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
++		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
++		remote-endpoint = <&hdmi_in_vp0>;
++	};
++};
++
++&rgmii_phy1 {
++	interrupt-parent = <&gpio0>;
++	interrupts = <RK_PC4 IRQ_TYPE_LEVEL_LOW>;
++	pinctrl-0 = <&eth_phy_reset_pin>, <&eth_phy_int_pin>;
++};
++
++&pinctrl {
++	gpio-leds {
++		working_led_pin: working-led-pin {
++			rockchip,pins = <0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
++		};
++	};
++
++	gmac {
++		eth_phy_int_pin: eth-phy-int-pin {
++			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;
++		};
++	};
++
++	sdmmc0 {
++		sdmmc0_vol_ctrl_h: sdmmc0-vol-ctrl-h {
++			rockchip,pins = <0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
++		};
++	};
++};
